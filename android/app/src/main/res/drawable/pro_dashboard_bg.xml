<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base deep green -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pro_green_bg" />
        </shape>
    </item>
    <!-- Center spotlight -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120%p"
                android:centerX="50%"
                android:centerY="30%"
                android:startColor="#1A2E4431"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Top glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0F3D1F"
                android:endColor="#00000000"
                android:centerY="20%" />
        </shape>
    </item>
</layer-list>
