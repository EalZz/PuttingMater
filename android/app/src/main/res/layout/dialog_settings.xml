<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <!-- 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ 설정"
        android:textSize="24sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <!-- 그린 스피드 설정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="거리 보정 단계"
            android:textSize="18sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="퍼팅 거리 보정값을 설정하세요 (1 - 10)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="15dp" />

        <!-- 현재 값 표시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 값: "
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/currentGreenSpeedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:textSize="20sp"
                android:textColor="#2196F3"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentGreenSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" (3.0m)"
                android:textSize="16sp"
                android:textColor="#2E7D32"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- SeekBar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnDecreaseStep"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:textSize="18sp"
                android:background="@drawable/btn_secondary"
                android:textColor="#333333" />

            <SeekBar
                android:id="@+id/greenSpeedSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="10"
                android:progress="10"
                android:progressTint="#2196F3"
                android:thumbTint="#2196F3" />

            <Button
                android:id="@+id/btnIncreaseStep"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:textSize="18sp"
                android:background="@drawable/btn_secondary"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- 범위 표시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="start" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="end" />

        </LinearLayout>

        <!-- 단위 설정 추가 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="속도 단위"
            android:textSize="18sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <!-- 현재 단위 표시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 단위: "
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/currentUnitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="cm/s"
                android:textSize="20sp"
                android:textColor="#4CAF50"
                android:textStyle="bold" />

        </LinearLayout>

        <Spinner
            android:id="@+id/unitSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

    <!-- 버튼들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="취소"
            android:textSize="16sp"
            android:background="@drawable/btn_secondary"
            android:textColor="#666666" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="저장"
            android:textSize="16sp"
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white" />

    </LinearLayout>

</LinearLayout>