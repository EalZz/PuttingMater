<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- 스크롤 영역 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnReconnect">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛳ Putting Meter"
                    android:textSize="36sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Putting Speed Analyzer"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:alpha="0.8"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <!-- Main Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                android:alpha="0.95">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Connection Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="20dp">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/status_dot_connected"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/connectionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Arduino 연결됨"
                            android:textSize="16sp"
                            android:textColor="#666666" />
                    </LinearLayout>

                    <!-- Speed Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="30dp">

                        <!-- Peak Speed -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peak Speed"
                            android:textSize="18sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="30dp">

                            <TextView
                                android:id="@+id/speedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="64sp"
                                android:textColor="#2196F3"
                                android:fontFamily="sans-serif-light" />

                            <TextView
                                android:id="@+id/speedUnitText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="cm/s"
                                android:textSize="18sp"
                                android:textColor="#999999"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>

                        <!-- Average Speed -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Average Speed"
                            android:textSize="18sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/avgSpeedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="64sp"
                                android:textColor="#4CAF50"
                                android:fontFamily="sans-serif-light" />

                            <TextView
                                android:id="@+id/avgSpeedUnitText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="cm/s"
                                android:textSize="18sp"
                                android:textColor="#999999"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                    </LinearLayout>


                    <!-- Distance Section -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#e0e0e0"
                        android:layout_marginBottom="20dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="예상 비거리"
                            android:textSize="16sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/distanceValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="40sp"
                                android:textColor="#FF9800"
                                android:fontFamily="sans-serif-light" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="m"
                                android:textSize="16sp"
                                android:textColor="#999999"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- Green Speed Indicator -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="15dp">

                            <TextView
                                android:id="@+id/greenSpeedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="보통 그린 (7.5)"
                                android:textSize="14sp"
                                android:textColor="#666666" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recent Records Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                android:alpha="0.95">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 최근 측정 기록"
                        android:textSize="20sp"
                        android:textColor="#333333"
                        android:layout_marginBottom="15dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recordsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 버튼: 초기화 / 설정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_alignParentBottom="true"
        android:layout_above="@+id/btnReconnect">

        <Button
            android:id="@+id/btnChart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="초기화"
            android:textSize="16sp"
            android:background="@drawable/btn_secondary"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️ 설정"
            android:textSize="16sp"
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- 재연결 버튼 -->
    <Button
        android:id="@+id/btnReconnect"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🔄 재연결"
        android:textSize="16sp"
        android:background="@drawable/btn_primary"
        android:textColor="@android:color/white"
        android:elevation="5dp"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        android:layout_margin="10dp" />

</RelativeLayout>
