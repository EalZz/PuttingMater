<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pro_dashboard_bg">

    <!-- 상단 고정 상태바 (Common) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/status_dot_connected"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/connectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connecting..."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
            
        <!-- 타이틀 제거됨 -->
    </LinearLayout>

    <!-- 중앙 컨텐츠 컨테이너 -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomNav">

        <!-- 1. HOME TAB (Dashboard) -->
        <LinearLayout
            android:id="@+id/layout_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <!-- Main Distance Card -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp"
                android:background="@drawable/pro_glass_card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREDICTED DISTANCE"
                    android:textColor="@color/pro_gold_accent"
                    android:textSize="14sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/distanceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/pro_orange_data"
                        android:textSize="110sp"
                        android:shadowColor="@color/pro_orange_glow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="25"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="m"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="22dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="200dp"
                android:layout_height="1dp"
                android:background="@color/pro_glass_stroke"
                android:layout_marginVertical="40dp" />

            <!-- Speed Cards Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:paddingHorizontal="25dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pro_glass_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PEAK SPEED"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/pro_cyan_data"
                        android:textSize="32sp"
                        android:shadowColor="@color/pro_cyan_glow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/speedUnitText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="cm/s"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pro_glass_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVG SPEED"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/avgSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/pro_cyan_data"
                        android:textSize="32sp"
                        android:shadowColor="@color/pro_cyan_glow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/avgSpeedUnitText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="cm/s"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. HISTORY TAB -->
        <LinearLayout
            android:id="@+id/layout_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Records"
                android:textColor="@color/pro_gold_accent"
                android:textSize="20sp"
                android:layout_marginBottom="20dp"
                android:fontFamily="sans-serif-black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recordsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- 3. SETTINGS TAB -->
        <ScrollView
            android:id="@+id/layout_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuration"
                    android:textColor="@color/pro_gold_accent"
                    android:textSize="20sp"
                    android:layout_marginBottom="30dp"
                    android:fontFamily="sans-serif-black" />

                <!-- Settings Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/pro_glass_card_bg"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보정 단계 (Green Speed)"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/greenSpeedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보통 그린 (7.5)"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp" />

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="보정 설정 열기"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/pro_green_bg"
                        android:textColor="@color/white"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnChart"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="데이터 초기화 (RESET)"
                    android:textColor="@color/white"
                    android:backgroundTint="#D32F2F"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btnReconnect"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="🔄 기기 재연결"
                    android:textColor="@color/pro_green_bg"
                    android:backgroundTint="@color/pro_gold_accent" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Version 2.0.0"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="40dp" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 하단 네비게이션 고정 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/pro_green_bg"
        app:itemIconTint="@color/pro_gold_accent"
        app:itemTextColor="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</RelativeLayout>
